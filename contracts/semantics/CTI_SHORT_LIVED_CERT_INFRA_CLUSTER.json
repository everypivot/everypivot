        {
          "name": "name_association",
          "kind": "assertion",
          "types": [
            "network:presentation_name"
          ],
          "where": {
            "op": "all",
            "args": [
              {
                "op": "eq",
                "left": {
                  "ref": "name_association.subject"
                },
                "right": {
                  "ref": "presentation.id"
                }
              },
              {
                "op": "eq",
                "left": {
                  "ref": "name_association.attributes.service_record"
                },
                "right": {
                  "ref": "service.id"
                }
              },
              {
                "op": "eq",
                "left": {
