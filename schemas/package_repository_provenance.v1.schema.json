{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EveryPivot package repository provenance v1.0",
  "$comment": "Apache-2.0. Independent evidence sidecar, not pivot-pattern v1.5 fields or build attestation. Semantic validation also requires matching package/repository/commit bindings, valid timestamps, ordered unique paths and snapshot digest consistency.",
  "type": "object",
  "properties": {
    "contract": {
      "const": "everypivot.package_repository_provenance"
    },
    "contract_version": {
      "const": "1.0"
    },
    "pattern_id": {
      "enum": [
        "SUPPLY_PACKAGE_REPO_TO_DOMAIN_INFRA",
        "CROSS_PACKAGE_REPO_TO_DOMAIN_INFRA"
      ]
    },
    "pattern_version": {
      "const": "3.0.0"
    },
    "evidence_mode": {
      "const": "evidence_only"
    },
    "build_provenance": {
      "const": "not_verified"
    },
    "package": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "registry",
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "repository_uri": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "declaration": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "version_source_repository",
            "mirror_reference"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "publisher": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "collection": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "acquired_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "required": [
            "publisher",
            "collection",
            "uri",
            "revision",
            "sha256",
            "field",
            "acquired_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "evidence"
      ],
      "additionalProperties": false
    },
    "revision_binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unresolved"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "declared"
            },
            "package": {
              "type": "object",
              "properties": {
                "registry": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "registry",
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "repository_uri": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "commit": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "algorithm": {
                      "const": "sha1"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  },
                  "required": [
                    "algorithm",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "algorithm": {
                      "const": "sha256"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "algorithm",
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "evidence": {
              "type": "object",
              "properties": {
                "publisher": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "collection": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uri": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "acquired_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
                }
              },
              "required": [
                "publisher",
                "collection",
                "uri",
                "revision",
                "sha256",
                "field",
                "acquired_at"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "package",
            "repository_uri",
            "commit",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "snapshot": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unresolved"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "hashed"
            },
            "method": {
              "const": "everypivot.git-tree-content.v1"
            },
            "algorithm": {
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "commit": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "algorithm": {
                      "const": "sha1"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  },
                  "required": [
                    "algorithm",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "algorithm": {
                      "const": "sha256"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "algorithm",
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path_base64": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755",
                      "120000"
                    ]
                  },
                  "size": {
                    "type": "integer"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path_base64",
                  "mode",
                  "size",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "method",
            "algorithm",
            "digest",
            "commit",
            "entries"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "contract",
    "contract_version",
    "pattern_id",
    "pattern_version",
    "evidence_mode",
    "build_provenance",
    "package",
    "repository_uri",
    "declaration",
    "revision_binding",
    "snapshot"
  ],
  "additionalProperties": false
}
